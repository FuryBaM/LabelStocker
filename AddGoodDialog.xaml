<Window x:Name="AddProductWindow" x:Class="ProductStorage.AddProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProductStorage"
        mc:Ignorable="d"
        Title="Добавить товар" Height="255" Width="320">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="351*"/>
            <ColumnDefinition Width="29*"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="btnDialogOk" Content="Создать" HorizontalAlignment="Left" Height="25" Margin="40,166,0,0" VerticalAlignment="Top" Width="115" Click="CreateButton_Click"/>
        <TextBox x:Name="nameTextBox" HorizontalAlignment="Left" Height="23" Margin="160,32,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <Label x:Name="productNameLabel" Content="Имя товара" HorizontalAlignment="Left" Margin="40,29,0,0" VerticalAlignment="Top" Width="115"/>
        <TextBox x:Name="priceTextBox" HorizontalAlignment="Left" Height="23" Margin="160,77,0,0" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" Width="120" PreviewTextInput="NumberValidationTextBox"/>
        <Label x:Name="productPriceLabel" Content="Цена" HorizontalAlignment="Left" Margin="40,77,0,0" VerticalAlignment="Top" Width="115"/>
        <Label x:Name="productGroupLabel" Content="Группа" HorizontalAlignment="Left" Margin="40,120,0,0" VerticalAlignment="Top" Width="115"/>
        <ComboBox x:Name="comboBox" HorizontalAlignment="Left" Margin="160,120,0,0" VerticalAlignment="Top" Width="120" Height="26"/>
        <Button x:Name="btnDialogCancel" Content="Отмена" HorizontalAlignment="Left" Height="25" Margin="165,166,0,0" VerticalAlignment="Top" Width="115" Click="CancelButton_Click"/>

    </Grid>
</Window>
